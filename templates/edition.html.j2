<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>MalNews | {{ date_long }}</title>
<link rel="stylesheet" href="edition.css">
</head>
<body>

<header class="masthead">
  <div class="dateline">
    <span>Edition {{ edition }}</span>
    <span>{{ date_long }}</span>
    <span>{{ read_minutes }} min read</span>
  </div>
  <h1>MalNews</h1>
  <div class="tagline">The five-minute security briefing</div>
  <div class="generated">Generated {{ generated }}</div>
</header>

{% if snapshot %}
<section class="snapshot">
  <div class="snap-text"><b>Today’s CVEs</b> · {{ snapshot.total }} in this edition · {{ snapshot.kev }} Known Exploited · {{ snapshot.zero_days }} zero-day{{ "" if snapshot.zero_days == 1 else "s" }}{% if snapshot.highest %} · highest score {{ snapshot.highest }}{% endif %}</div>
  <table class="bar"><tr>{% for seg in snapshot.segments %}<td class="sev-{{ seg.cls }}" style="width: {{ seg.width }}">{{ seg.label }} {{ seg.count }}</td>{% endfor %}</tr></table>
</section>
{% endif %}

{% macro severity(c) %}
{% if c.score %}<span class="badge sev-{{ c.band | lower }}">{{ c.band }} {{ c.score }}</span>
{% elif c.status == "pending" %}<span class="badge sev-none">Score pending</span>
{% else %}<span class="badge sev-none">Score unavailable</span>{% endif %}
{% endmacro %}

{% macro badges(s) %}
{% if s.top %}{{ severity(s.top) }}{% endif %}
{% if s.kev %}<span class="badge kev">Known Exploited</span>{% endif %}
{% endmacro %}

{% macro cve_lines(s) %}
{% if s.cves %}
<ul class="cves">
  {% for c in s.cves %}
  <li>{{ severity(c) }} <a href="{{ c.cve_url }}">{{ c.id }}</a> · <a href="{{ c.nvd_url }}">NVD</a>{% if c.kev %} · Known Exploited{% if c.kev_detail %}: {{ c.kev_detail }}{% endif %}{% endif %}{% if c.epss %} · EPSS {{ c.epss }}{% endif %}</li>
  {% endfor %}
</ul>
{% endif %}
{% endmacro %}

{% macro links(s) %}
<p class="links">{% for publisher, href in s.links %}<a href="{{ href }}">{{ publisher }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
{% endmacro %}

{% macro photo(img) %}
{% if img %}
<figure class="photo">
  <img src="{{ img.src }}" alt="{{ img.alt }}">
  <figcaption>Image: <a href="{{ img.href }}">{{ img.credit }}</a></figcaption>
</figure>
{% endif %}
{% endmacro %}

{% macro story(s, cls="") %}
<article class="story {{ cls }}">
  <div class="badges">{{ badges(s) }}</div>
  <h3>{{ s.title }}</h3>
  {% if cls == "lead" %}{{ photo(s.image) }}{% endif %}
  <p>{{ s.summary }}</p>
  {% if s.mitigation %}<p class="fix"><b>Fix:</b> {{ s.mitigation }}</p>{% endif %}
  {{ cve_lines(s) }}
  {{ links(s) }}
</article>
{% endmacro %}

{% if story_of_week %}
{% set w = story_of_week %}
<section class="sotw">
  <div class="kicker">Story of the Week{% if w.updated %} <span class="updated">{{ w.updated }}</span>{% endif %}</div>
  <div class="badges">{{ badges(w) }}</div>
  <h2>{{ w.title }}</h2>
  {{ photo(w.image) }}
  {% for label, text in w.parts %}
  <p><b>{{ label }}.</b> {{ text }}</p>
  {% endfor %}
  {{ cve_lines(w) }}
  {{ links(w) }}
</section>
{% endif %}

{# One story spans the full width; several flow in two columns, and short sections keep each story whole. #}
{% macro block(items, cls="", few=4) %}
{% if items | length == 1 %}{{ story(items[0], cls ~ " solo") }}
{% elif items %}<div class="paper{{ ' few' if items | length < few }}">{% for s in items %}{{ story(s, cls) }}{% endfor %}</div>{% endif %}
{% endmacro %}

{% if news_of_the_day %}
<h2 class="section">News of the Day</h2>
{{ story(news_of_the_day[0], "lead") }}
{{ block(news_of_the_day[1:], "", 5) }}
{% endif %}

{% if new_threats %}
<h2 class="section">New Threats</h2>
{{ block(new_threats, "threat") }}
{% endif %}

{% if headlines %}
<h2 class="section">Other Headlines</h2>
<div class="paper">{% for s in headlines %}{{ story(s) }}{% endfor %}</div>
{% endif %}

{% if roundup %}
<section class="roundup">
  <h2 class="section">Known Exploited Roundup</h2>
  <table>
    <tr><th>CVE</th><th>Vendor and product</th><th>Vulnerability</th><th>Added</th><th>Score</th><th>EPSS</th></tr>
    {% for r in roundup %}
    <tr>
      <td><a href="{{ r.cve_url }}">{{ r.id }}</a> · <a href="{{ r.nvd_url }}">NVD</a></td>
      <td>{{ r.vendor }}</td>
      <td>{{ r.name }}{% if r.ransomware %} †{% endif %}</td>
      <td>{{ r.added }}</td>
      <td>{{ severity(r) }}</td>
      <td>{{ r.epss or "–" }}</td>
    </tr>
    {% endfor %}
  </table>
  <p class="note">The newest additions to CISA’s Known Exploited Vulnerabilities catalog that are not covered above. † Used in ransomware campaigns.</p>
</section>
{% endif %}

<footer>
  <p><b>Sources:</b> {{ sources | join(", ") }}.</p>
  <p>Summaries are AI-written from the linked articles.
  Scores come from NVD (CVSS), CISA’s Known Exploited Vulnerabilities catalog, and FIRST EPSS.
  Bands: Critical 9.0–10.0, High 7.0–8.9, Medium 4.0–6.9, Low 0.1–3.9.</p>
</footer>

</body>
</html>
